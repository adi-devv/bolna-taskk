# Bolna AI Configuration
# Get your API key from: platform.bolna.ai → Developers tab
BOLNA_API_KEY=your_bolna_api_key_here

# Create an agent in Bolna dashboard and paste the Agent ID here
BOLNA_AGENT_ID=your_agent_id_here

# Bolna API base URL (default)
BOLNA_API_BASE_URL=https://api.bolna.dev

# Your app's public URL (used as webhook URL for Bolna)
# For local dev use ngrok: https://your-ngrok-id.ngrok.io
# For production: https://your-domain.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000
